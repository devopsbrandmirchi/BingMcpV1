# Public origin of this app, no trailing slash.
# Local: http://localhost:3000
# Cloud Run: https://bing-mcp-v1-xxxxxxxxxx-uc.a.run.app
APP_BASE_URL=http://localhost:3000

# Microsoft Entra app registration (application/client ID and secret).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Must match a redirect URI on this app's Entra registration.
# Defaults to ${APP_BASE_URL}/oauth/microsoft/callback if omitted.
MICROSOFT_REDIRECT_URI=http://localhost:3000/oauth/microsoft/callback

# Application-level Microsoft Advertising developer token.
# This is NOT a per-operator or per-connection credential.
# Never expose through MCP tools or logs.
MICROSOFT_ADS_DEVELOPER_TOKEN=

# Required. Signs MCP authorization codes and access/refresh tokens.
MCP_TOKEN_SECRET=

# Required. Signs Microsoft OAuth state and encrypts pending-authorize cookies.
OAUTH_STATE_SECRET=

# Required. 32-byte key used to encrypt Microsoft refresh tokens at rest.
# 64 hex characters, or any long random string (hashed to 32 bytes).
TOKEN_ENCRYPTION_KEY=

# Firestore project. On Cloud Run this can match the runtime project.
FIRESTORE_PROJECT_ID=

# Required. Named Firestore database for this app only.
# Must be bing-mcp-v1. Must NOT be "(default)" or gconnect-mcp-all-v1.
FIRESTORE_DATABASE_ID=bing-mcp-v1

# Local/test only. Example: localhost:8080
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Optional. Only if you paste a confidential client into Claude.ai
# Custom Connector Advanced Settings.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
